# Copy to .env.local (or run `vercel env pull`). Never commit real values.
# Neon Postgres connection string (server only)
DATABASE_URL_DATABASE_URL=
# Neon Auth: Neon Console > Auth > Configuration
DATABASE_URL_NEON_AUTH_BASE_URL=
# Any random string of 32+ characters, e.g. `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=
